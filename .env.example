# PizzaCraft Environment Variables Example
PORT=5000

# MongoDB URI (supports local MongoDB or MongoDB Atlas cloud database)
MONGODB_URI=mongodb://127.0.0.1:27017/pizzacraft
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/pizzacraft?retryWrites=true&w=majority

# JWT Authentication Configuration
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRES_IN=7d
